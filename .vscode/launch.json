{
  // F5 -> "Run packaged Workbench". Needs the extension ms-vscode.cpptools (C/C++).
  // If you do not want to install it, use Terminal > Run Build Task instead (tasks.json).
  // Linux/macOS: run scripts/build_native.sh once first (or use the task, which does it for you).
  // Windows: open the unzipped submission folder in VS Code; Launch.exe sits at its root.
  // (In the development repo, run scripts/package.sh first and copy dist/*/Launch.exe + web/ + data/ to the root.)
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run packaged Workbench",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "windows": {
        "type": "cppvsdbg",
        "program": "${workspaceFolder}\\Launch.exe"
      },
      "linux": {
        "type": "cppdbg",
        "MIMode": "gdb",
        "program": "${workspaceFolder}/build/Launch",
        "args": []
      },
      "osx": {
        "type": "cppdbg",
        "MIMode": "lldb",
        "program": "${workspaceFolder}/build/Launch",
        "args": []
      }
    }
  ]
}
